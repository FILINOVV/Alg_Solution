<!-- Переиспользуемый 3D-график. Один режим — ShowSurface: несколько кривых (каждая на своей
     "глубине" по оси Z) соединяются гладкой сеткой-поверхностью, как в части с матрицами.
     Для матриц глубина — настоящее число (m), для сравнения алгоритмов — просто порядковое
     место кривой, а подписи на оси глубины — имена алгоритмов. Вращение сцены — своей рукой
     написанное (см. код), не через встроенный контроллер камеры HelixToolkit. -->
<UserControl x:Class="LabApp.Ui.Chart3DView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="http://helix-toolkit.org/wpf">
    <!-- Background="Transparent" здесь обязателен: без него WPF не считает пустые (прозрачные)
         места "своими" для мыши, и мышь проваливается насквозь — вращать можно было бы только
         если попасть курсором ровно на видимую линию, а это почти вся площадь графика. -->
    <Grid Background="Transparent">
        <h:HelixViewport3D x:Name="Viewport"
                            Background="Transparent"
                            ShowCoordinateSystem="False"
                            ShowViewCube="False"
                            ShowFrameRate="False"
                            ZoomExtentsWhenLoaded="False"
                            IsRotationEnabled="False"
                            IsPanEnabled="True"
                            IsZoomEnabled="True"/>

        <!-- Подписи осей — ОБЫЧНЫЙ 2D-текст поверх 3D-сцены (а не 3D-биллборды внутри неё).
             Их экранное положение каждый кадр пересчитывается из 3D-координат в коде (проекция
             камеры), поэтому они всегда читаются как нормальный текст фиксированного размера в
             пикселях — сколько бы ни крутили и ни масштабировали график. IsHitTestVisible="False",
             чтобы не мешать вращению мышью. -->
        <Canvas x:Name="LabelCanvas" IsHitTestVisible="False"/>

        <!-- Легенда — нужна только в режиме "лент" (surface — всегда одна поверхность, легенда не нужна) -->
        <Border x:Name="LegendBorder" Background="#CC202020" CornerRadius="6" Padding="10,8"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Visibility="Collapsed">
            <StackPanel x:Name="LegendPanel"/>
        </Border>

        <TextBlock Text="ЛКМ — вращение, колесо — масштаб, ПКМ — сдвиг" FontSize="10"
                   Foreground="#88FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"/>
    </Grid>
</UserControl>
