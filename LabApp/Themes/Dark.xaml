<!-- Тёмная палитра. Ключи должны совпадать с Light.xaml -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BgBrush" Color="#0F1115"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#15181E"/>
    <SolidColorBrush x:Key="CardBrush" Color="#1A1D24"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#2A2F3A"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#3A4150"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E6E8EE"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9AA3B2"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#5B8DEF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#7AA3F3"/>
    <SolidColorBrush x:Key="AccentBgBrush" Color="#1E2A44"/>
    <SolidColorBrush x:Key="InputBgBrush" Color="#12151B"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#222733"/>
    <SolidColorBrush x:Key="RowAltBrush" Color="#1E222A"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#3A4150"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#32D583"/>
    <SolidColorBrush x:Key="SuccessBgBrush" Color="#103A26"/>
</ResourceDictionary>
