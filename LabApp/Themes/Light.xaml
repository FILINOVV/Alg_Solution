<!-- Светлая палитра. Ключи должны совпадать с Dark.xaml -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BgBrush" Color="#F4F6FA"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E4E7EC"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#C9CED6"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1C2333"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#2F6FED"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2459C8"/>
    <SolidColorBrush x:Key="AccentBgBrush" Color="#EAF1FE"/>
    <SolidColorBrush x:Key="InputBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#F1F4F9"/>
    <SolidColorBrush x:Key="RowAltBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C9CED6"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#12B76A"/>
    <SolidColorBrush x:Key="SuccessBgBrush" Color="#E7F9EF"/>
</ResourceDictionary>
